# ==============================================================================
# SANCTUARY (STUDY & ATELIER) — ENVIRONMENT SPECIFICATION
# ==============================================================================
# Copy this file to .env.local to configure your active environment.
# Never commit .env.local with live secrets to version control.
# ==============================================================================

# Supabase Public API Endpoint (HTTPS)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon Public API Key (JWT)
# Safe to expose in the browser; protected by Row Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (JWT)
# STRICTLY SERVER-ONLY. Grants elevated administrative bypass rights.
# NEVER prefix with NEXT_PUBLIC_. Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Application Base Canonical URL
# Used for authentication redirect callbacks, magic links, and email confirmations.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Business Timezone Specification
# Business accounting and dates operate under Asia/Kolkata
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Kolkata

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY (STANDARD CHECKOUT — TEST MODE)
# ==============================================================================
# Public Key ID for browser checkout.js in TEST mode
# Example: rzp_test_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server Key ID (TEST mode)
RAZORPAY_KEY_ID=

# Server Key Secret (TEST mode) — STRICTLY SERVER-ONLY
RAZORPAY_KEY_SECRET=

# Webhook Secret for validating HMAC SHA-256 signatures on incoming webhook events
RAZORPAY_WEBHOOK_SECRET=

# Shared Secret for authenticating scheduled reconciliation cron jobs
CRON_SECRET=

